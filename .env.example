# Configuração local do portefólio. Copie para .env e preencha apenas no seu computador.
# Nunca cometa .env no Git nem envie os valores em mensagens.

# MySQL persistente usado pela aplicação
DATABASE_URL=

# Identidade e sessão da aplicação Manus
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_OAUTH_API_URL=

# API e armazenamento Manus
MANUS_API_URL=
MANUS_API_KEY=

# Configuração pública do cliente / início de sessão
MANUS_OAUTH_PORTAL_URL=
MANUS_API_BROWSER_KEY=

# Opcional: identificador legado do proprietário
OWNER_OPEN_ID=

# Só é necessário para a primeira activação de administrador nesta base local
ADMIN_SETUP_CODE=

# Login local do painel, quando a chave Manus não está configurada
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

PORT=3000
